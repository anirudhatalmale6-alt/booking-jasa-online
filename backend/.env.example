# Salin file ini menjadi ".env" lalu ganti nilainya.
# (Copy this file to ".env" then change the values.)

# Port tempat server backend berjalan
PORT=4000

# Kunci rahasia untuk menandatangani token login (JWT).
# WAJIB diganti dengan string acak yang panjang saat produksi.
JWT_SECRET=ganti-dengan-kunci-rahasia-yang-panjang-dan-acak

# Alamat frontend yang diizinkan mengakses API (untuk CORS)
CLIENT_URL=http://localhost:5173
